#!/usr/bin/env bash

set -euo pipefail

if [[ "$OSTYPE" == darwin* ]]; then
  defaults read ~/Library/Preferences/com.apple.HIToolbox.plist AppleSelectedInputSources |
    awk '/KeyboardLayout Name/ {
      split($0, fields, "=")
      layout = fields[2]
      gsub(/[ ;."]/, "", layout)
      print toupper(substr(layout, 1, 2))
    }'
else
  echo "󰖭 "
fi
