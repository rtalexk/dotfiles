#!/usr/bin/env bash

split_command() {
  local input=${1-}

  input=${input//$'\n'/ }
  read -r cmd subcmd _ <<< "$input"
}

split_command "${1-}"
cmd="${cmd##*/}"

shopt -s nocasematch

# INFO: Claude, OpenCode, Lazygit, Nvim & GH Dash icons must be unique.
if [[ "$cmd" == "alx" ]]; then
  case "$subcmd" in
    brain) icon="" ;;
    todo)  icon="" ;;
    *)     icon="" ;;
  esac
else
  case "$cmd" in
    claude)                       icon="" ;;
    opencode)                     icon="󰨔" ;;
    nvim)                         icon="󰘦" ;;
    lazygit)                      icon="" ;;
    gh-dash)                      icon="" ;;
    gh)                           icon="" ;;
    vim | vi)                     icon="󰅩" ;;
    git)                          icon="" ;;
    ruby | irb | pry)             icon="" ;;
    node | npm | npx | bun)       icon="" ;;
    python | python3 | ipython)   icon="" ;;
    go | air)                     icon="" ;;
    rust | cargo)                 icon="" ;;
    docker)                       icon="" ;;
    kubectl | k9s)                icon="󱃾" ;;
    htop | btop | top)            icon="󰨇" ;;
    ssh)                          icon="󰣀" ;;
    psql | mysql | sqlite3)       icon="" ;;
    fzf)                          icon="" ;;
    bash | zsh | fish | sh)       icon="" ;;
    man)                          icon="" ;;
    *)                            icon="" ;;
  esac
fi

printf '%s\n' "$icon"
