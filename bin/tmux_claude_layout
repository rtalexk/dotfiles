#!/usr/bin/env ruby
# frozen_string_literal: true

require 'digest'
require 'open3'
require 'securerandom'
require 'tmpdir'

THRESHOLD            = 200
MAX_CLAUDE_PANE_COLS = 90
NVIM_WINDOW          = "󰘦"
CLAUDE_WINDOW        = ""
CLAUDE_CMD           = "fnm use default; claude"
DEBOUNCE_SECS        = 0.15

# Run a tmux command and return its stdout.
def tmux(*args)
  out, err, status = Open3.capture3("tmux", *args)
  raise "tmux command failed: #{args.inspect}: #{err.strip}" unless status.success?

  out.strip
end

# Run a tmux command for side effects (does not capture output).
def tmux!(*args)
  return if system("tmux", *args)

  raise "tmux command failed: #{args.inspect}"
end

def current_session
  tmux("display-message", "-p", '#S')
end

def positive_width(value, label)
  width = Integer(value, exception: false)
  raise "invalid #{label}: #{value.inspect}" unless width&.positive?

  width
end

def client_width
  positive_width(tmux("display-message", "-p", '#{client_width}'), "client width")
end

def window_width(target)
  positive_width(tmux("display-message", "-p", "-t", target, '#{window_width}'), "window width")
end

def find_claude_pane(session)
  lines = tmux(
    "list-panes", "-s", "-t", session,
    "-F", '#{@main_claude}:#{pane_id}:#{window_name}'
  ).lines
  lines.each do |line|
    flag, pane_id, window_name = line.strip.split(":", 3)
    return { pane_id: pane_id, window_name: window_name } if flag == "1"
  end
  adopt_untagged_claude_pane(session)
end

def adopt_untagged_claude_pane(session)
  lines = tmux(
    "list-windows", "-t", session,
    "-F", '#{window_name}:#{window_id}'
  ).lines
  lines.each do |line|
    name, window_id = line.strip.split(":", 2)
    next unless name == CLAUDE_WINDOW
    pane_id = tmux("display-message", "-p", "-t", window_id, '#{pane_id}')
    tag_claude_pane(pane_id)
    return { pane_id: pane_id, window_name: name }
  end
  nil
end

def find_nvim_window(session)
  lines = tmux(
    "list-windows", "-t", session,
    "-F", '#{window_name}:#{window_id}'
  ).lines
  lines.each do |line|
    name, window_id = line.strip.split(":", 2)
    return window_id if name == NVIM_WINDOW
  end
  nil
end

def claude_pane_size(width)
  [[width * 40 / 100, MAX_CLAUDE_PANE_COLS].min, 1].max
end

def tag_claude_pane(pane_id)
  tmux!("set-option", "-p", "-t", pane_id, "@main_claude", "1")
end

def focus_pane(pane_id)
  window_id = tmux("display-message", "-p", "-t", pane_id, '#{window_id}')
  tmux!("select-window", "-t", window_id)
  tmux!("select-pane", "-t", pane_id)
end

def pane_current_path(pane_id = nil)
  args = ["display-message", "-p"]
  args.concat(["-t", pane_id]) if pane_id
  tmux(*args, '#{pane_current_path}')
end

def open_claude_in_nvim(nvim_window_id, source_pane = nil)
  current_path = pane_current_path(source_pane)
  pane_id = tmux(
    "split-window", "-h", "-l", claude_pane_size(window_width(nvim_window_id)).to_s,
    "-t", nvim_window_id,
    "-c", current_path,
    "-P", "-F", '#{pane_id}',
    "sh", "-c", CLAUDE_CMD
  )
  tag_claude_pane(pane_id)
  focus_pane(pane_id)
end

def open_claude_standalone(source_pane = nil)
  current_path = pane_current_path(source_pane)
  pane_id = tmux(
    "new-window",
    "-n", CLAUDE_WINDOW,
    "-c", current_path,
    "-P", "-F", '#{pane_id}',
    "sh", "-c", CLAUDE_CMD
  )
  tag_claude_pane(pane_id)
end

def open_mode(session = current_session, width = client_width, source_pane = nil)
  width = positive_width(width, "client width")
  claude = find_claude_pane(session)

  if claude
    focus_pane(claude[:pane_id])
    return
  end

  nvim_window = find_nvim_window(session)

  if width >= THRESHOLD && nvim_window
    open_claude_in_nvim(nvim_window, source_pane)
  else
    open_claude_standalone(source_pane)
  end
end

def resize_mode(session = current_session, width = client_width, focused_pane = nil)
  width = positive_width(width, "client width")
  claude  = find_claude_pane(session)
  return unless claude

  standalone  = claude[:window_name] == CLAUDE_WINDOW
  nvim_window = find_nvim_window(session)

  focused_pane ||= tmux("display-message", "-p", '#{pane_id}')

  if width >= THRESHOLD && standalone && nvim_window
    tmux!("join-pane", "-h", "-s", claude[:pane_id], "-t", nvim_window, "-l", claude_pane_size(window_width(nvim_window)).to_s)
    focus_pane(focused_pane)
  elsif width >= THRESHOLD && !standalone
    tmux!("resize-pane", "-t", claude[:pane_id], "-x", claude_pane_size(window_width(claude[:pane_id])).to_s)
  elsif width < THRESHOLD && !standalone
    tmux!("break-pane", "-s", claude[:pane_id], "-n", CLAUDE_WINDOW)
    focus_pane(focused_pane)
  end
end

def debounce_file(session)
  server = ENV.fetch("TMUX", "").split(",", 2).first
  namespace = Digest::SHA256.hexdigest("#{server}\0#{session}")[0, 16]
  File.join(Dir.tmpdir, "tmux_claude_resize.#{namespace}.debounce")
end

def read_token(path)
  File.read(path)
rescue Errno::ENOENT
  nil
end

def with_debounce_lock(path)
  File.open("#{path}.lock", File::RDWR | File::CREAT, 0o600) do |lock|
    lock.flock(File::LOCK_EX)
    yield
  end
end

def debounced_resize(session = nil, width = nil, focused_pane = nil)
  session ||= current_session
  width ||= client_width
  path = debounce_file(session)
  token = SecureRandom.hex
  with_debounce_lock(path) { File.write(path, token) }
  sleep DEBOUNCE_SECS

  with_debounce_lock(path) do
    return unless read_token(path) == token

    File.delete(path)
    resize_mode(session, width, focused_pane)
  end
end

case ARGV[0]
when "open"   then open_mode(ARGV[1] || current_session, ARGV[2] || client_width, ARGV[3])
when "resize" then debounced_resize(ARGV[1], ARGV[2], ARGV[3])
else
  warn "Usage: tmux_claude_layout <open|resize>"
  exit 1
end
