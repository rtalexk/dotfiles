#!/usr/bin/env zsh

ZSH_THEME_GIT_PROMPT_PREFIX=" %F{8}(%F{red}"
ZSH_THEME_GIT_PROMPT_SUFFIX="%F{8})%f"
ZSH_THEME_GIT_PROMPT_DIRTY="%F{yellow} ✗"
ZSH_THEME_GIT_PROMPT_CLEAN=""

_prompt_visible_length() {
  setopt localoptions extendedglob
  local expanded=${(%%)1}
  expanded=${(S)expanded//$'\e'\[[0-9;]#[a-zA-Z]/}
  print -r -- ${#expanded}
}

_prompt_dir() {
  local common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
  if [[ ${common:t} == .bare ]]; then
    print -r -- "../${PWD:h:t}/${PWD:t}/"
  else
    print -r -- "../${PWD:t}"
  fi
}

_prompt_render() {
  local head="%F{green}[ %n ]%f %F{cyan}${$(_prompt_dir)//\%/%%}%f$(git_prompt_info)"
  local tail="%F{245}%D{%b %-d at %H:%M:%S}%f"
  local empty="" spacer

  local gap=$(( COLUMNS - 3 - $(_prompt_visible_length $head) - $(_prompt_visible_length $tail) ))
  if (( gap > 3 )); then
    spacer=" %F{8}${(l:$((gap - 2))::-:)empty}%f "
  else
    (( gap < 1 )) && gap=1
    spacer=${(l:gap:: :)empty}
  fi

  PROMPT="${_prompt_lead}%F{8}╭─%f${head}${spacer}${tail}"$'\n'"%F{8}╰─%f%F{green}\$%f "
}

_prompt_mark_command() { _prompt_command_ran=1 }

# Lead is fixed per prompt so a resize redraw keeps it
_prompt_set_lead() {
  _prompt_lead=""
  (( _prompt_command_ran )) && _prompt_lead=$'\n'
  _prompt_command_ran=0
}

preexec_functions+=(_prompt_mark_command)
precmd_functions+=(_prompt_set_lead _prompt_render)
RPROMPT=''

TRAPWINCH() {
  _prompt_render
  zle && zle reset-prompt
}
