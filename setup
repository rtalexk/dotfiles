#!/bin/bash

set -e

# Colors for output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[0;33m'
NC='\033[0m' # No Color

log() {
    echo -e "${BLUE}==>${NC} $1"
}

success() {
    echo -e "${GREEN}✓${NC} $1"
}

warn() {
    echo -e "${YELLOW}!${NC} $1"
}

# Set XDG_CONFIG_HOME if not already set
if [ -z "$XDG_CONFIG_HOME" ]; then
    export XDG_CONFIG_HOME="$HOME/.config"
    log "XDG_CONFIG_HOME not set, using default: $XDG_CONFIG_HOME"
fi

mkdir -p "$XDG_CONFIG_HOME" "$HOME/.local/bin"

# Check brew is installed
if ! command -v brew &>/dev/null; then
    echo "Homebrew not found, please install it first from https://brew.sh/"
    exit 1
fi

# Check gh cli is installed
if ! command -v gh &>/dev/null; then
    log "Installing GitHub CLI..."
    brew install gh
fi

# Check stow is installed
if ! command -v stow &>/dev/null; then
    log "Installing stow..."
    brew install stow
fi

# Work specific settings
if [ ! -f "$PWD/shell/.config/shell/work" ]; then
    log "Creating work config from example..."
    cp "$PWD/shell/.config/shell/work.example" "$PWD/shell/.config/shell/work"
fi

# Oh My Zsh (must be installed before stowing shell configs)
log "Installing external dependencies..."
if [ ! -d "$HOME/.oh-my-zsh" ]; then
    log "Installing Oh My Zsh..."
    KEEP_ZSHRC=yes RUNZSH=no CHSH=no sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
fi

# Oh My Zsh writes its own .zshrc when none exists, which then blocks stow
for target in "$HOME/.zshrc" "$HOME/.tmux.conf"; do
    if [ -f "$target" ] && [ ! -L "$target" ]; then
        log "Backing up existing $(basename "$target") to $target.pre-dotfiles.bak"
        mv "$target" "$target.pre-dotfiles.bak"
    fi
done

# Stow packages (must run before external deps that clone into config dirs)
log "Stowing configurations..."

# Remove broken symlinks that may point to a previous dotfiles location
find "$HOME" -maxdepth 1 -type l -exec sh -c '[ ! -e "$1" ] && rm "$1"' _ {} \;
find "$HOME/.config" -maxdepth 1 -type l -exec sh -c '[ ! -e "$1" ] && rm "$1"' _ {} \;

# stow whole-links a directory the target lacks, which would send the runtime
# state these tools write into their config directories straight into this
# repository
mkdir -p "$HOME/.claude" "$HOME/.config/opencode" "$XDG_CONFIG_HOME/git"

stow --restow --dir="$PWD" --target="$HOME" shell tmux nvim terminal git-tools demux agents
success "Configurations stowed"

# Private config, cloned beside the worktrees so no worktree has to ignore it
PRIVATE_REPO="$("$PWD/bin/private_repo_url" "$PWD/shell/.config/shell/work")"
PRIVATE_ROOT="$(dirname "$PWD")/private"

if [ -z "$PRIVATE_REPO" ]; then
    log "DOTFILES_PRIVATE_REPO unset, skipping private config"
elif [ ! -d "$PRIVATE_ROOT/.git" ]; then
    log "Cloning private config..."
    git clone "$PRIVATE_REPO" "$PRIVATE_ROOT" || log "Private config unavailable, skipping"
fi

if [ -x "$PRIVATE_ROOT/setup" ]; then
    "$PRIVATE_ROOT/setup" || log "Private setup failed, continuing"
fi

# The private repo owns ~/.claude/settings.json. Without it Claude Code starts
# with defaults: no hooks, no autoMode policy. That is quiet enough to go
# unnoticed, so say so loudly.
if [ ! -e "$HOME/.claude/settings.json" ]; then
    warn "~/.claude/settings.json is missing, so Claude Code has no hooks and no autoMode policy"
    warn "it comes from the private repo, so fix the private phase above and re-run"
fi

# $BRAIN notes vault, lives in iCloud and is linked into ~/Documents
BRAIN_TARGET="${ICLOUD:-$HOME/Library/Mobile Documents/com~apple~CloudDocs}/Notes"
BRAIN_LINK="$HOME/Documents/Notes"
if [ ! -d "$BRAIN_TARGET" ]; then
    log "iCloud Notes not found, skipping \$BRAIN link"
elif [ -e "$BRAIN_LINK" ] && [ ! -L "$BRAIN_LINK" ]; then
    log "$BRAIN_LINK exists and is not a symlink, leaving it alone"
else
    mkdir -p "$(dirname "$BRAIN_LINK")"
    ln -sfn "$BRAIN_TARGET" "$BRAIN_LINK"
    success "\$BRAIN linked to iCloud Notes"
fi

# Tmux Package Manager
if [ ! -d "$HOME/.tmux/plugins/tpm" ]; then
    git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
    success "TPM installed"
fi

# Alacritty themes and the Catppuccin tmux theme are vendored as submodules
git -C "$PWD" submodule update --init --recursive
success "Theme submodules checked out"

# Zsh autosuggestions
if [ ! -d "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh-autosuggestions" ]; then
    git clone https://github.com/zsh-users/zsh-autosuggestions "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh-autosuggestions"
    success "Zsh autosuggestions installed"
fi

# Install packages
log "Installing packages with Homebrew..."

brew install rg fd gnu-sed wget fzf zoxide
success "General utility packages installed"

# brew install --cask alacritty
brew install --cask ghostty
success "Ghostty installed"

brew install nvim
success "Neovim installed"

brew install tree-sitter-cli
success "Tree-sitter CLI installed"

brew install glow
success "Glow installed"

brew install tmux
success "Tmux installed"

brew install sesh
success "Sesh installed"

brew install font-hack-nerd-font
success "Hack Nerd Font installed"

brew install --cask raycast
success "Raycast installed"

brew install go
success "Go installed"

brew install jesseduffield/lazygit/lazygit
go install github.com/arl/gitmux@latest
gh extension install dlvhdr/gh-dash
brew install delta
success "Git tools installed"

brew install fnm pnpm
success "Node packages installed"

# Backs the PreToolUse hook the private repo configures in ~/.claude/settings.json
brew install rtk
# Generates ~/.claude/RTK.md, which CLAUDE.md references as @RTK.md.
# --no-patch still writes RTK.md, and leaves the linked settings.json alone
rtk init --global --no-patch
success "rtk installed and initialized"

# Build and install custom alx CLI
if [ -d "$PWD/alx" ]; then
    log "Building alx CLI..."
    cd alx && go build && cd ..
    if [ ! -d "$HOME/.local/bin" ]; then
        mkdir -p "$HOME/.local/bin"
    fi
    ln -sf "$PWD/alx/alx" "$HOME/.local/bin/alx"
    success "alx CLI built and installed"
fi

# demux, built from source into the bare-worktree layout alx and sessions.toml expect
DEMUX_ROOT="${PROJECTS:-$HOME/com.github}/demux"
if [ ! -d "$DEMUX_ROOT/.bare" ]; then
    log "Cloning demux..."
    git clone --bare https://github.com/rtalexk/demux.git "$DEMUX_ROOT/.bare"
    printf 'gitdir: ./.bare\n' >"$DEMUX_ROOT/.git"
    git -C "$DEMUX_ROOT/.bare" config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
    git -C "$DEMUX_ROOT/.bare" fetch origin
    git -C "$DEMUX_ROOT" worktree add "$DEMUX_ROOT/main" main
fi

log "Building demux..."
demux_version=$(git -C "$DEMUX_ROOT/main" describe --tags --always)
(cd "$DEMUX_ROOT/main" && go build -ldflags "-X github.com/rtalexk/demux/cmd.Version=${demux_version#v}" -o demux .)
ln -sf "$DEMUX_ROOT/main/demux" "$HOME/.local/bin/demux"
success "demux $demux_version built and installed"

echo ""
echo -e "${GREEN}Setup complete!${NC}"

# === Linux specific packages
# sudo apt install build-essential ripgrep tmux fd-find -y

# Ruby
# gpg --keyserver keyserver.ubuntu.com --recv-keys 409B6B1796C275462A1703113804BB82D39DC0E3 7D2BAF1CF37B13E2069D6956105BD0E739499BDB
# sudo apt-add-repository -y ppa:rael-gc/rvm
# sudo apt-get update
# sudo apt-get install rvm -y
# sudo usermod -a -G rvm $USER
# echo -e '\nsource "/etc/profile.d/rvm.sh"' >> ~/.bashrc
